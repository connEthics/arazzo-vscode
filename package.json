{
  "name": "arazzo-vscode",
  "publisher": "connethics",
  "displayName": "Arazzo for VS Code — by ConnEthics",
  "pricing": "Free",
  "license": "MIT",
  "description": "Arazzo 1.1 workflows for OpenAPI and AsyncAPI: validation against the official schema, completion, quick fixes (migrate to 1.1), interactive theme-aware graph and live docs. By ConnEthics.",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0f172a",
    "theme": "dark"
  },
  "homepage": "https://github.com/connEthics/arazzo-vscode#readme",
  "bugs": {
    "url": "https://github.com/connEthics/arazzo-vscode/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/connEthics/arazzo-vscode.git"
  },
  "version": "2.0.0",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Visualization",
    "Snippets"
  ],
  "keywords": [
    "arazzo",
    "arazzo-1.1",
    "openapi",
    "asyncapi",
    "oai",
    "workflow",
    "api-workflow",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "e2e",
    "e2e-testing",
    "api-testing",
    "yaml",
    "validation",
    "linter",
    "json-schema",
    "graph",
    "flowchart",
    "visualization",
    "documentation",
    "mermaid",
    "connethics"
  ],
  "activationEvents": [
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "arazzo-vscode.openPreview",
        "title": "Open Arazzo Preview",
        "icon": "$(preview)"
      },
      {
        "command": "arazzo-vscode.openFlowchart",
        "title": "Open Arazzo Flowchart",
        "icon": "$(graph)"
      },
      {
        "command": "arazzo-vscode.migrateTo11",
        "title": "Migrate to Arazzo 1.1.0",
        "category": "Arazzo"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "arazzo-vscode.openPreview",
          "when": "resourceLangId == yaml",
          "group": "navigation"
        },
        {
          "command": "arazzo-vscode.openFlowchart",
          "when": "resourceLangId == yaml",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "arazzo-vscode.migrateTo11",
          "when": "editorLangId == yaml"
        }
      ]
    },
    "snippets": [
      {
        "language": "yaml",
        "path": "./snippets/arazzo.code-snippets"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "cd webview-ui && npm install && npm run build && cd .. && npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "vendor:check": "node scripts/vendor-check.mjs",
    "vendor:sync": "node ../arazzo-demo/scripts/sync-shared.mjs arazzo-core . && node ../arazzo-demo/scripts/sync-shared.mjs arazzo-flow ."
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.1",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "webpack": "^5.103.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "yaml": "^2.8.2"
  }
}
