.vscode/**
.vscode-test/**
out/**
node_modules/**
src/**
.gitignore
.yarnrc
webpack.config.js
vsc-extension-quickstart.md
**/tsconfig.json
**/eslint.config.mjs
**/*.map
**/*.ts
**/.vscode-test.*
.github/**
context/**
.vscode-test.mjs

# Vendored @connethics/arazzo-core and arazzo-flow: bundled into dist/extension.js
# (core) and webview-ui/build (core, flow, ELK worker), so only their license
# notices ship: MIT + Apache-2.0 notice for the OAI schemas, MIT for arazzo-flow,
# EPL-2.0 for elkjs (webview-ui/build/assets/elk-worker.js).
vendor/**
!vendor/@connethics/arazzo-core/LICENSE
!vendor/@connethics/arazzo-flow/LICENSE
!vendor/@connethics/arazzo-flow/dist/elk-worker.LICENSE.md
scripts/**

# Screenshots for the README / site (linked from GitHub, not needed in the VSIX)
images/v2/**

# Webview UI exclusions (include only the production build)
webview-ui/**
!webview-ui/build/**

# Dev tooling — must never ship in the VSIX
.claude/**
.planning/**
.specify/**
.automaker/**
specs/**
CLAUDE.md
SUPPORT.md
CONTRIBUTING.md

