{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@connethics/arazzo-core": ["../vendor/@connethics/arazzo-core/dist/index.d.ts"],
      "@connethics/arazzo-flow": ["../vendor/@connethics/arazzo-flow/dist/index.d.ts"],
      "react": ["./node_modules/@types/react/index.d.ts"],
      "elkjs/lib/elk-api": ["./node_modules/elkjs/lib/elk-api.d.ts"]
    }
  },
  "include": ["src"]
}
